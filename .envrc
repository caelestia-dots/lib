shopt -s globstar
watch_file include/**/*.hpp
watch_file src/**/*.cpp
watch_file tests/**/*.cpp
watch_file tests/**/*.hpp
watch_file **/CMakeLists.txt

if ! cmake --build build --target help &> /dev/null; then
    args=()
    if has clazy; then
        args+=(-DCMAKE_CXX_COMPILER=clazy)
    else
        args+=(-DCMAKE_CXX_COMPILER=clang++)
    fi
    if has ccache; then
        args+=(-DCMAKE_CXX_COMPILER_LAUNCHER=ccache)
    fi

    cmake -B build -G Ninja \
        -DCMAKE_BUILD_TYPE=RelWithDebInfo \
        -DCMAKE_EXPORT_COMPILE_COMMANDS=ON \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DDISTRIBUTOR=direnv \
        -DBUILD_TESTING=ON \
        "${args[@]}"
fi
cmake --build build
